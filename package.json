{
  "name": "docgraphical",
  "version": "1.0.0",
  "description": "Surgical precision Markdown AST, TOC outline & section slicer for AI Agents. Save 97% tokens.",
  "main": "electron/main.js",
  "bin": {
    "docgraphical": "./bin/docgraphical.js",
    "docg": "./bin/docgraphical.js",
    "docgraph": "./bin/docgraphical.js"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node test.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "keywords": [
    "docgraph",
    "markdown",
    "ast",
    "toc",
    "ai-agent",
    "mcp",
    "token-saver",
    "rag"
  ],
  "author": "Chunghsing Tech / CodeGraph Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.docgraphical.app",
    "productName": "DocGraphical",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "app/**/*",
      "assets/**/*",
      "lib/**/*",
      "bin/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DocGraphical"
    },
    "icon": "assets/icon.png"
  },
  "files": [
    "bin/**/*",
    "lib/**/*",
    "electron/**/*",
    "app/**/*",
    "assets/**/*",
    "README.md",
    "README.zh-TW.md",
    "LICENSE"
  ]
}